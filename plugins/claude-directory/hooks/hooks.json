{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": [
              "-y",
              "thumbgate@1.41.0",
              "gate-check"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": [
              "-y",
              "thumbgate@1.41.0",
              "hook-auto-capture"
            ]
          }
        ]
      }
    ]
  }
}
