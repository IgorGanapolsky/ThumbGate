{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./scripts/gate-check.sh",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./scripts/cursor-hook.sh mcp-gate"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/prompt-capture.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/observe-tool-result.sh",
        "matcher": "swarm-claim\\.py"
      },
      {
        "command": "./scripts/cursor-hook.sh record"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/cursor-hook.sh record"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "./scripts/cursor-hook.sh record"
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}\"/scripts/cursor-hook.sh stop",
        "loop_limit": 1
      }
    ]
  }
}
