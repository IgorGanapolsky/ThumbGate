{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./scripts/gate-check.sh",
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/prompt-capture.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/observe-tool-result.sh",
        "matcher": "swarm-claim\\.py"
      }
    ]
  }
}
