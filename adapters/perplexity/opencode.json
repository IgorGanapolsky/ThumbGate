{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "thumbgate": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "--package",
        "thumbgate@1.36.0",
        "thumbgate",
        "serve"
      ],
      "enabled": true
    },
    "perplexity": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      },
      "enabled": true
    }
  },
  "notes": "For Perplexity hybrid local-cloud (Computex 2026 Personal Computer orchestrator): see adapters/perplexity/HYBRID.md. Use perplexity/hybrid-* in model-candidates for routing. Add gates for hybrid routing decisions."
}
