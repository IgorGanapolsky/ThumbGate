{
  "mcpServers": {
    "thumbgate": {
      "command": "npx",
      "args": ["--yes", "--package", "thumbgate@latest", "thumbgate", "serve"]
    }
  },
  "hooks": {
    "preToolUse": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "thumbgate@latest",
        "thumbgate",
        "gate-check"
      ]
    },
    "userPromptSubmit": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "thumbgate@latest",
        "thumbgate",
        "hook-auto-capture"
      ]
    }
  },
  "notes": "Claude Code MCP config with ThumbGate gates for Hugging Face Context Course exercises. PreToolUse hook gates all tool calls. All configs run thumbgate@latest. See HF_CONTEXT.md for unit-by-unit integration guide."
}
