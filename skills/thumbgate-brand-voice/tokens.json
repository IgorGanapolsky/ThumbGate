{
  "version": "1.0.0",
  "theme": "dark-premium",
  "colors": {
    "background": {
      "primary": "#0c0d0e",
      "secondary": "#151719",
      "tertiary": "#1e2124"
    },
    "border": {
      "primary": "#272a2e",
      "secondary": "#383c42"
    },
    "foreground": {
      "primary": "#f3f4f6",
      "secondary": "#9ca3af",
      "tertiary": "#6b7280"
    },
    "accent": {
      "amber": "#f59e0b",
      "emerald": "#10b981",
      "rose": "#f43f5e",
      "slate": "#4b5563"
    }
  },
  "typography": {
    "sans": {
      "family": "Inter, Outfit, sans-serif",
      "weights": ["400", "500", "600", "700"]
    },
    "mono": {
      "family": "JetBrains Mono, Fira Code, monospace",
      "weights": ["400", "500"]
    }
  },
  "layout": {
    "borderRadius": {
      "small": "4px",
      "medium": "8px",
      "large": "12px"
    },
    "borderWidth": "1px",
    "gridGutter": "1.5rem"
  },
  "visuals": {
    "illustrations": "dark-minimalist-schematics",
    "diagrams": "mermaid-flowcharts-only",
    "branding": {
      "logo": "assets/thumbgate_logo_dark.svg",
      "icon": "assets/thumbgate_icon_dark.png"
    }
  }
}
