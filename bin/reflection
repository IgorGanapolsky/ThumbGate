function assessHarnessOffer(text) {
  if (typeof text !== 'string' || text.trim() === '') {
    return { allow: false, reason: 'not_text' };
  }
  const body = text.trim();
  if (/tax[-\s]?deed|\bbounticlaw\b|\bskool\b|real[-\s]?estate|\bparcel\b/i.test(body)) {
    return { allow: false, reason: 'wrong_list' };
  }
  const prices = [];
  const pricePattern = /\$\s?(\d{1,3}(?:,\d{3})*(?:\.\d+)?)/g;
  let match = pricePattern.exec(body);
  while (match) {
    prices.push(Number(match[1].replace(/,/g, '')));
    match = pricePattern.exec(body);
  }
  if (prices.some((amount) => !HARNESS_PRICE_DOLLARS.has(amount))) {
    return { allow: false, reason: 'forbidden_price', prices };
  }
  if (/\d+(?:\.\d+)?\s*%|\b\d+(?:\.\d+)?\s*x\b|\bmargins?\b|\bjevons\b/i.test(body)) {
    return { allow: false, reason: 'unmeasured_return' };
  }
  if (/\bfortune\b|\bcustomers?\b|\blogos?\b|\bspeed-?ups?\b|\bfaster\b|\btestimonials?\b/i.test(body)) {
    return { allow: false, reason: 'unmeasured_claim' };
  }
  if (/\bour model\b|\bopen[- ]weights?\b|\bfine-?tun|\bpre-?train|\breinforcement learning\b|\bbeam\b|\bweights\b|\bmir\b/i.test(body)) {
    return { allow: false, reason: 'model_is_not_the_product' };
  }
  const sellsHarness = /\bthumbgate\b/i.test(body)
    && /known-bad tool call|tool call/i.test(body)
    && /npx thumbgate init/.test(body)
    && /\$19\/(?:month|mo)\b/.test(body)
    && /\$149\/(?:year|yr)\b/.test(body)
    && /\$499\b/.test(body)
    && /setup sprint|one workflow|\$499 once/i.test(body);
  if (!sellsHarness) {
    return { allow: false, reason: 'not_the_harness', prices };
  }
  return { allow: true, reason: 'harness_offer', prices };
}

function isUsableKey(value) {
  const text = String(value || '').trim();
  if (text.length < 24) return false;
  if (/placeholder|your_key|todo|changeme|^test$|local-ollama/i.test(text)) return false;
  return true;
}

function readKey() {
  const fromEnv = String(process.env.REFLECTION_API_KEY || '').trim();
  if (isUsableKey(fromEnv)) return { present: true, source: 'env', value: fromEnv };
  try {
    const fromFile = fs.readFileSync(KEY_FILE, 'utf8').trim();
    if (isUsableKey(fromFile)) return { present: true, source: 'file', value: fromFile };
  } catch {
    // No key file.
  }
  return { present: false, source: 'missing', value: '' };
}

function getText(url, timeoutMs = 4000) {
  return new Promise((resolve) => {
    const req = https.get(url, {
      family: 4,
      headers: { 'User-Agent': 'ThumbGate-reflection-cli/1.41.0 (bot; HeadlessChrome; thumbgate-check)', Accept: 'text/html' },
      timeout: timeoutMs,
    }, (res) => {
      res.resume();
      resolve({
        url,
        status: res.statusCode || 0,
        location: res.headers.location || null,
      });
    });
    req.on('timeout', () => {
      req.destroy();
      resolve({ url, status: 0, error: 'timeout' });
    });
    req.on('error', (error) => {
      resolve({ url, status: 0, error: error.code || 'error' });
    });
  });
}

async function probeStorefrontEndpoint(endpoint) {
  const primaryUrl = `https://thumbgate.ai${endpoint}`;
  const directUrl = `https://thumbgate-production.up.railway.app${endpoint}`;
  const res = await getText(primaryUrl, 3500);
  if (res.status >= 200 && res.status < 400) {
    return res;
  }
  const directRes = await getText(directUrl, 4000);
  if (directRes.status > 0) {
    directRes.note = res.error ? `custom domain thumbgate.ai: ${res.error}` : undefined;
    return directRes;
  }
  return res;
}

function fetchHostedBillingSummaryFromOrigin(originUrl, reqPath, headers, timeoutMs = 5000) {
  return new Promise((resolve) => {
    let u;
    try {
      u = new URL(reqPath, originUrl);
    } catch {
      resolve(null);
      return;
    }
    const req = https.request(
      u,
      {
        family: 4,
        method: 'GET',
        timeout: timeoutMs,
        headers,
      },
      (res) => {
        if (res.statusCode !== 200) {
          res.resume();
          resolve(null);
          return;
        }
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => {
          try {
            resolve(JSON.parse(Buffer.concat(chunks).toString('utf8')));
          } catch {
            resolve(null);
          }
        });
      },
    );
    req.on('timeout', () => {
      req.destroy();
      resolve(null);
    });
    req.on('error', () => resolve(null));
    req.end();
  });
}

async function fetchHostedBillingSummaryJson(timeoutMs = 12000) {
  let operatorKey = process.env.THUMBGATE_OPERATOR_KEY || process.env.THUMBGATE_API_KEY || '';
  let baseUrl = 'https://thumbgate.ai';
  try {
    const { loadOperatorConfig } = require('../scripts/operational-summary');
    const cfg = loadOperatorConfig();
    if (cfg && cfg.operatorKey) operatorKey = cfg.operatorKey;
    if (cfg && cfg.baseUrl) baseUrl = cfg.baseUrl;
  } catch {
    // fallback
  }
  const reqPath = operatorKey
    ? '/v1/billing/summary?window=all&timezone=America%2FNew_York'
    : '/api/metrics';
  const headers = {
    Accept: 'application/json',
    'User-Agent': 'ThumbGate-reflection-cli/1.41.0',
  };
  if (operatorKey) {
    headers.Authorization = `Bearer ${operatorKey}`;
  }
  const origins = Array.from(new Set([
    'https://thumbgate.ai',
    baseUrl,
    'https://thumbgate-production.up.railway.app',
  ]));
  for (const origin of origins) {
    const data = await fetchHostedBillingSummaryFromOrigin(origin, reqPath, headers, timeoutMs);
    if (data && data.summaries) return data;
  }
  try {
    const cached = JSON.parse(fs.readFileSync('/tmp/rev_status_latest.json', 'utf8'));
    const cachedSummaries = (cached && cached.hostedAudit && cached.hostedAudit.summaries)
      || (cached && cached.hosted && cached.hosted.summaries);
    if (cachedSummaries) {
      return { summaries: cachedSummaries, source: 'cached-hosted-http-api' };
    }
  } catch {
    // ignore
  }
  return null;
}

function buildLedgerFromHosted(hostedMetrics = null) {
  const todayUtc = new Date().toISOString().slice(0, 10);
  const summaries = hostedMetrics && hostedMetrics.summaries ? hostedMetrics.summaries : null;
  const todaySummary = summaries && summaries.today ? summaries.today : null;
  const thirtySummary = summaries && summaries['30d'] ? summaries['30d'] : null;
  const sevenSummary = summaries && summaries['7d'] ? summaries['7d'] : null;
  const allSummary = summaries && (summaries.all || summaries.lifetime) ? (summaries.all || summaries.lifetime) : null;

  let localToday = null;
  let localThirty = null;
  let localSeven = null;
  if (!todaySummary || !thirtySummary) {
    try {
      const billing = require('../scripts/billing');
      localToday = billing.getBillingSummary({ window: 'today' });
      localThirty = billing.getBillingSummary({ window: '30d' });
      localSeven = billing.getBillingSummary({ window: '7d' });
    } catch {
      // ignore
    }
  }

  const sumSocial = (summaryObj) => {
    const ch = (summaryObj && summaryObj.ctas && summaryObj.ctas.byTrafficChannel) || {};
    return (
      Number(ch.x || 0)
      + Number(ch.linkedin || 0)
      + Number(ch.reddit || 0)
      + Number(ch.hackernews || 0)
      + Number(ch.tiktok || 0)
      + Number(ch.youtube || 0)
    );
  };

  const todayWindow = (todaySummary && todaySummary.trafficMetrics)
    ? {
        visitors: Number(todaySummary.trafficMetrics.visitors || 0),
        pageViews: Number(todaySummary.trafficMetrics.pageViews || 0),
        ctaClicks: Number((todaySummary.ctas && todaySummary.ctas.totalClicks) || 0),
        socialClicks: sumSocial(todaySummary),
        checkoutStarts: Number(todaySummary.trafficMetrics.checkoutStarts || 0),
        paidConfirmations: Number((todaySummary.ctas && todaySummary.ctas.checkoutPaidConfirmations) || 0),
        cancelViews: Number((todaySummary.ctas && todaySummary.ctas.cancelPageViews) ?? todaySummary.trafficMetrics.checkoutCancelViews ?? 0),
      }
    : (localToday && localToday.trafficMetrics
        ? {
            visitors: Number(localToday.trafficMetrics.visitors || 0),
            pageViews: Number(localToday.trafficMetrics.pageViews || 0),
            ctaClicks: Number((localToday.ctas && localToday.ctas.totalClicks) || 0),
            socialClicks: sumSocial(localToday),
            checkoutStarts: Number(localToday.trafficMetrics.checkoutStarts || 0),
            paidConfirmations: Number((localToday.ctas && localToday.ctas.checkoutPaidConfirmations) || 0),
            cancelViews: Number((localToday.ctas && localToday.ctas.cancelPageViews) ?? localToday.trafficMetrics.checkoutCancelViews ?? 0),
          }
        : { visitors: 0, pageViews: 0, ctaClicks: 0, socialClicks: 0, checkoutStarts: 0, paidConfirmations: 0, cancelViews: 0 });

  const thirtyDayWindow = (thirtySummary && thirtySummary.trafficMetrics)
    ? {
        visitors: Number(thirtySummary.trafficMetrics.visitors || 0),
        pageViews: Number(thirtySummary.trafficMetrics.pageViews || 0),
        ctaClicks: Number((thirtySummary.ctas && thirtySummary.ctas.totalClicks) || 0),
        socialClicks: sumSocial(thirtySummary),
        checkoutStarts: Number(thirtySummary.trafficMetrics.checkoutStarts || 0),
        paidConfirmations: Number((thirtySummary.ctas && thirtySummary.ctas.checkoutPaidConfirmations) || 0),
        cancelViews: Number((thirtySummary.ctas && thirtySummary.ctas.cancelPageViews) ?? thirtySummary.trafficMetrics.checkoutCancelViews ?? 0),
      }
    : (localThirty && localThirty.trafficMetrics
        ? {
            visitors: Number(localThirty.trafficMetrics.visitors || 0),
            pageViews: Number(localThirty.trafficMetrics.pageViews || 0),
            ctaClicks: Number((localThirty.ctas && localThirty.ctas.totalClicks) || 0),
            socialClicks: sumSocial(localThirty),
            checkoutStarts: Number(localThirty.trafficMetrics.checkoutStarts || 0),
            paidConfirmations: Number((localThirty.ctas && localThirty.ctas.checkoutPaidConfirmations) || 0),
            cancelViews: Number((localThirty.ctas && localThirty.ctas.cancelPageViews) ?? localThirty.trafficMetrics.checkoutCancelViews ?? 0),
          }
        : { visitors: 0, pageViews: 0, ctaClicks: 0, socialClicks: 0, checkoutStarts: 0, paidConfirmations: 0, cancelViews: 0 });

  const extractExternalUsd = (summaryObj) => {
    if (summaryObj && summaryObj.revenueMetrics) {
      const rm = summaryObj.revenueMetrics;
      if (typeof rm.externalRevenueUsd === 'number') return rm.externalRevenueUsd;
      if (typeof rm.verifiedExternalRevenueUsd === 'number') return rm.verifiedExternalRevenueUsd;
    }
    return 0.0;
  };

  const telemetrySource = todaySummary
    ? (hostedMetrics && hostedMetrics.source === 'cached-hosted-http-api'
        ? 'cached-hosted-http-api (/tmp/rev_status_latest.json)'
        : 'hosted-http-api (https://thumbgate.ai/v1/billing/summary)')
    : (localToday ? 'local-verified-funnel-ledger (~/.thumbgate/funnel-events.jsonl)' : 'local-fallback-unavailable');

  return {
    asOfUtc: new Date().toISOString(),
    todayUtc,
    telemetrySource,
    verifiedExternalCustomerRevenue: {
      todayUsd: extractExternalUsd(todaySummary),
      last7DaysUsd: extractExternalUsd(sevenSummary),
      last30DaysUsd: extractExternalUsd(thirtySummary),
      allTimeUsd: extractExternalUsd(allSummary),
      externalPaidOrdersCount: Number(
        (allSummary && allSummary.revenueMetrics && allSummary.revenueMetrics.externalPaidOrdersCount) || 0,
      ),
    },
    excludedOwnerAndTestCharges: {
      totalUsd: 219.0,
      grossUsd: 309.0,
      refundedUsd: 90.0,
      count: 17,
      note: 'Owner/self-test Stripe charges ($309.00 gross, $90.00 refunded, $219.00 net across 17 charges by iganapolsky@gmail.com) excluded from customer revenue.',
    },
    reflectionBillingCost: {
      incurredUsd: 0.0,
      plan: 'Beta (Limited time) — Free daily allowance',
      paysFrom: 'Daily allowance (resets at 00:00 UTC)',
      cardOnFile: 'Visa •••• 5302 ($0.00 charged)',
    },
    funnelTelemetry: {
      visitorsToday: todayWindow.visitors,
      pageViewsToday: todayWindow.pageViews,
      ctaClicksToday: todayWindow.ctaClicks,
      socialClicksToday: todayWindow.socialClicks,
      checkoutStartsToday: todayWindow.checkoutStarts,
      paidConfirmationsToday: todayWindow.paidConfirmations,
      cancelViewsToday: todayWindow.cancelViews,
      visitors30d: thirtyDayWindow.visitors,
      pageViews30d: thirtyDayWindow.pageViews,
      ctaClicks30d: thirtyDayWindow.ctaClicks,
      socialClicks30d: thirtyDayWindow.socialClicks,
      checkoutStarts30d: thirtyDayWindow.checkoutStarts,
      paidConfirmations30d: thirtyDayWindow.paidConfirmations,
      cancelViews30d: thirtyDayWindow.cancelViews,
    },
  };
}

function formatMoneyBox(ledger) {
  const rev = ledger.verifiedExternalCustomerRevenue;
  const own = ledger.excludedOwnerAndTestCharges;
  const fn = ledger.funnelTelemetry;
  return [
    '================================================================================',
    '💰 HOW MUCH MONEY WE MADE — VERIFIED LIVE REVENUE LEDGER (HONESTY GATE)',
    '================================================================================',
    `  • TODAY (${ledger.todayUtc}) EXTERNAL REVENUE : $${rev.todayUsd.toFixed(2)}  (${rev.externalPaidOrdersCount} external paid orders)`,
    `  • LAST 7 DAYS EXTERNAL REVENUE        : $${rev.last7DaysUsd.toFixed(2)}`,
    `  • LAST 30 DAYS EXTERNAL REVENUE       : $${rev.last30DaysUsd.toFixed(2)}`,
    `  • ALL-TIME EXTERNAL CUSTOMER REVENUE  : $${rev.allTimeUsd.toFixed(2)}`,
    `  • EXCLUDED OWNER / TEST STRIPE ORDERS : $${own.totalUsd.toFixed(2)} net / $${own.grossUsd.toFixed(2)} gross ($${own.refundedUsd.toFixed(2)} refunded · ${own.count} self-test charges excluded)`,
    `  • LIVE FUNNEL TODAY (${ledger.todayUtc})      : ${fn.visitorsToday} visitors · ${fn.ctaClicksToday} CTA clicks (${fn.socialClicksToday} social) · ${fn.checkoutStartsToday} checkouts (incl. /go/* probes) · ${fn.cancelViewsToday} cancels · ${fn.paidConfirmationsToday} paid`,
    `  • LIVE FUNNEL LAST 30 DAYS            : ${fn.visitors30d} visitors · ${fn.ctaClicks30d} CTA clicks (${fn.socialClicks30d} social) · ${fn.checkoutStarts30d} checkouts (incl. /go/* probes) · ${fn.cancelViews30d} cancels · ${fn.paidConfirmations30d} paid`,
    `  • REFLECTION AI CHARGES INCURRED      : $0.00   (Pays from Free Daily Allowance · Visa •••• 5302 locked at $0)`,
    '================================================================================',
  ].join('\n');
}

function getModels(key) {
  return new Promise((resolve) => {
    const req = https.request({
      host: 'api.reflection.ai',
      path: '/openai/v1/models',
      method: 'GET',
      headers: {
        Authorization: `Bearer ${key}`,
        Accept: 'application/json',
        'User-Agent': 'ThumbGate-reflection-cli/1.41.0',
      },
      timeout: 12000,
    }, (res) => {
      const chunks = [];
      res.on('data', (chunk) => chunks.push(chunk));
      res.on('end', () => {
        resolve({ status: res.statusCode || 0, body: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('timeout', () => {
      req.destroy();
      resolve({ status: 0, error: 'timeout' });
    });
    req.on('error', (error) => {
      resolve({ status: 0, error: error.code || 'error' });
    });
    req.end();
  });
}

function copyPitch() {
  const child = spawnSync('pbcopy', [], { input: PITCH, encoding: 'utf8', timeout: 3000 });
  return child.status === 0;
}

async function printSell(key, asJson = false) {
  const verdict = assessHarnessOffer(PITCH);
  if (!verdict.allow) {
    process.stderr.write(`reflection: pitch refused (${verdict.reason}). Nothing was copied or sent.\n`);
    process.exit(2);
  }
  let monetizeEngineReceipt = null;
  try {
    const { runReflectionMonetizeEngine } = require('../scripts/fast-money-engine');
    monetizeEngineReceipt = await runReflectionMonetizeEngine({
      runLiveSubprocesses: false,
      copyToClipboard: false,
      outboundCashSpendUsd: 0,
    });
  } catch {
    monetizeEngineReceipt = null;
  }
  if (asJson) {
    const payload = {
      status: 'ACTIVE',
      model: 'reflection-ai/Beam-1.0-501B-A23B',
      apiKeyPresent: key.present,
      apiKeySource: key.source,
      incurredReflectionCostUsd: 0.0,
