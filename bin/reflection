function resolveChannel(rawKey = '') {
  const norm = String(rawKey || '').trim().toLowerCase();
  if (norm === 'hn' || norm === 'hackernews' || norm === 'showhn' || norm === 'news') return MARKETING_CHANNELS.hn;
  if (norm === 'linkedin' || norm === 'li' || norm === 'cto') return MARKETING_CHANNELS.linkedin;
  if (norm === 'x' || norm === 'twitter' || norm === 'tweet') return MARKETING_CHANNELS.x;
  if (norm === 'recovery' || norm === 'cancel' || norm === 'abandoned' || norm === 'cart') return MARKETING_CHANNELS.recovery;
  if (norm === 'pitch' || norm === 'all' || norm === 'default' || !norm) return MARKETING_CHANNELS.pitch;
  return null;
}

function copyChannel(channel) {
  const text = channel.copy;
  const child = spawnSync('pbcopy', [], { input: text, encoding: 'utf8', timeout: 3000 });
  const copied = child.status === 0;
  return {
    channelId: channel.id,
    name: channel.name,
    targetUrl: channel.targetUrl,
    copiedToClipboard: copied,
    text,
  };
}

function launchChannel(channel, options = {}) {
  const copyRes = copyChannel(channel);
  let browserOpened = false;
  if (process.platform === 'darwin' && !options.noOpen) {
    try {
      spawnSync('open', [channel.targetUrl], { stdio: 'ignore', timeout: 3000 });
      browserOpened = true;
    } catch {
      browserOpened = false;
    }
  }
  return {
    ...copyRes,
    browserOpened,
  };
}

