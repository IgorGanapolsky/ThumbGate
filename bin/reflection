  } catch {
    // non-fatal
  }
  const fn = ledger.funnelTelemetry;
  const hnLines = viralRadar && Array.isArray(viralRadar.liveHnThreads)
    ? viralRadar.liveHnThreads.slice(0, 4).map(
        (t) => `     • [HN score=${t.velocityScore} | ${t.points}p/${t.comments}c] ${t.title.slice(0, 62)} -> ${t.itemUrl}`,
      )
    : [];
  const lines = [
    formatMoneyBox(ledger),
    '',
    '🚀 MONETIZATION READINESS & HONESTY GATE (LOCAL CLI DOES NOT AUTO-POST OR CHARGE):',
    `  0. Fast-Money Execution Guide (Turn This $0.00 Ledger Into Cash):`,
    `     • Why $0.00 Was Made   : 141 users reached checkout and 40 cancelled, with 0 outbound campaigns sent.`,
    `     • Step 1 (Show HN)     : Run "./bin/reflection launch hn" (copies Show HN text + opens submit page)`,
    `     • Step 2 (40 Cancels)  : Run "./bin/reflection launch recovery" (copies $49 one-time non-subscription downsell)`,
    `     • Step 3 (LinkedIn)    : Run "./bin/reflection launch linkedin" (copies CTO hook + opens LinkedIn)`,
    `     • Step 4 (X / Twitter) : Run "./bin/reflection launch x" (copies tweet thread + opens tweet window)`,
    `     • Step 5 (Dashboard)   : Run "./bin/reflection fast-money" for priority ranking`,
    `  1. Reflection Billing Guard : $0.00 charged (${ledger.reflectionBillingCost.plan})`,
    `     • Free Daily Allowance   : 10M uncached input/day + 1M output/day + Unlimited cached input`,
    `     • Local Hard Cap         : 8M input / 800K output per UTC day (allowPaidOverage=false — Visa •••• 5302 protected)`,
    `  2. Read-Only Storefront Health Probes (Zero Fake Stripe Sessions Minted):`,
    ...checks.map((c) => {
      const loc = c.location ? ` -> ${c.location.slice(0, 72)}...` : '';
      const err = c.error ? ` (${c.error})` : '';
      const note = c.note ? ` [${c.note}]` : '';
      return `     • [${c.status}${err}] ${c.url}${loc}${note}`;
    }),
    `  3. Funnel Conversion & Abandonment Diagnosis (${ledger.telemetrySource}):`,
    `     • Today (${ledger.todayUtc})     : ${fn.visitorsToday} visitors -> ${fn.ctaClicksToday} CTA clicks (${fn.socialClicksToday} social) -> ${fn.checkoutStartsToday} checkouts (incl. automated /go/* smoke probes) -> ${fn.cancelViewsToday} cancels -> $0.00 paid (${fn.paidConfirmationsToday} paid confirmations)`,
    `     • Last 30 Days           : ${fn.visitors30d} visitors -> ${fn.ctaClicks30d} CTA clicks (${fn.socialClicks30d} social) -> ${fn.checkoutStarts30d} checkouts (incl. automated /go/* smoke probes) -> ${fn.cancelViews30d} cancels -> $0.00 paid (${fn.paidConfirmations30d} paid confirmations)`,
    `     • Downsell Recovery Armed: One-time $9.99 Playbook (/go/playbook-999) + $49 Rule-Pack (/go/bundle-49) live on /checkout/pro & /checkout/cancel`,
    `  4. Active Monetization Channels Armed ($0.00 Outbound Spend):`,
    ...OFFERS.map((offer) => `     • ${offer.name.padEnd(24)} ${offer.price.padEnd(12)} ${offer.url}`),
    `  5. Viral Multi-Channel Radar (Hacker News + LinkedIn + TikTok + Reddit + Lobste.rs):`,
    `     • Hacker News Show HN    : ${CHECKOUT_LINKS.hackerNewsShowHn}`,
    ...hnLines,
    `     • LinkedIn Carousel CTA  : ${CHECKOUT_LINKS.linkedinViralPro19}`,
    `     • TikTok Short-Video CTA : ${CHECKOUT_LINKS.tiktokViralPro19}`,
    `  6. UTM + Viral Attributed Pitch (${copied ? 'COPIED TO CLIPBOARD' : 'READY'}):`,
    ...PITCH.split('\n').map((line) => `     ${line}`),
    `  7. Active Monetize Engine Dispatch Queue (${monetizeEngineReceipt && monetizeEngineReceipt.makeMoneyReceiptOk ? 'READY' : 'UNAVAILABLE'}):`,
    ...(monetizeEngineReceipt && Array.isArray(monetizeEngineReceipt.immediateDispatchQueue)
      ? [
          `     • Queue Artifact Written : ${monetizeEngineReceipt.dispatchQueuePath}`,
          ...monetizeEngineReceipt.immediateDispatchQueue.slice(0, 4).map(
            (item) => `     • [#${item.priority} ${item.channel}] ${item.targetBuyer || item.target || 'Buyer'} (${item.targetOffer || item.offerPrice || '$49'}) -> ${item.checkoutUrl || item.actionUrl || item.intentUrl || 'staged'}`,
          ),
        ]
      : []),
    `  8. Live Viral Critique Harvester & Cunningham's Law Roast Loop (reflection critique):`,
    ...(critiqueReport && critiqueReport.liveViralFeedbackScorecard
      ? [
          `     • Live Feedback Scorecard: ${critiqueReport.liveViralFeedbackScorecard.explicitWrittenCritiquesCount} explicit buyer-loss critique(s) · ${critiqueReport.liveViralFeedbackScorecard.allTimeCheckoutCancelViews} cancel views · ${critiqueReport.liveViralFeedbackScorecard.allTimeInterstitialAbandoned} interstitial abandonments (${critiqueReport.liveViralFeedbackScorecard.allTimeInterstitialViews || 0} interstitial views) · ${critiqueReport.liveViralFeedbackScorecard.socialHumanEventsCount} all-time social CTA clicks (${critiqueReport.liveViralFeedbackScorecard.socialCtaClicks30d || 0} in 30d; ${critiqueReport.liveViralFeedbackScorecard.socialBotDeflectionsCount} link-preview bots deflected)`,
          ...critiqueReport.liveViralFeedbackScorecard.rootCauseDiagnosis.map((d) => `     • ${d}`),
          `     • Roast Landing Funnel   : https://thumbgate.ai/?roast=1&utm_source=hackernews&utm_medium=roast_my_stack&utm_campaign=nov2026_roast`,
          `     • Public Critique Ingest : POST https://thumbgate.ai/v1/telemetry/ping (eventType=buyer_loss_feedback)  |  CLI: npx thumbgate roast "your critique"`,
        ]
      : []),
    `  9. Autonomous Business Growth & Profit OS v4.0 (Captain Scorecard):`,
    ...(monetizeEngineReceipt && monetizeEngineReceipt.businessOsV4
      ? [
          `     • Run ID & Schema        : ${monetizeEngineReceipt.businessOsV4.runId} (schema_version=${monetizeEngineReceipt.businessOsV4.schemaVersion})`,
          `     • Root-Cause Diagnosis   : ${monetizeEngineReceipt.businessOsV4.diagnosisHeadline}`,
          `     • Top Priority Action    : #1 ${monetizeEngineReceipt.businessOsV4.topOpportunity.title} (score=${monetizeEngineReceipt.businessOsV4.topOpportunity.priorityScore})`,
          `     • Checkpoint Cursor      : ${monetizeEngineReceipt.businessOsV4.checkpointCursor} (.thumbgate/business-os-v4-run-record.json)`,
        ]
      : []),
    formatMoneyBox(ledger),
  ];
  process.stdout.write(`${lines.join('\n')}\n`);
}

async function printModels(key) {
  if (!key.present || !key.value) {
    process.stderr.write('reflection models: no API key. No request was sent.\n');
    process.exit(2);
  }
  const result = await getModels(key.value);
  if (result.error) {
    process.stderr.write(`reflection models: ${result.error}\n`);
    process.exit(1);
  }
  let ids = [];
  let code = '';
  try {
    const parsed = JSON.parse(result.body || '{}');
    ids = Array.isArray(parsed.data) ? parsed.data.map((row) => row.id).filter(Boolean) : [];
    code = parsed.error && parsed.error.code ? String(parsed.error.code) : '';
  } catch {
    code = 'unreadable_response';
  }
  process.stdout.write(`${JSON.stringify({ status: result.status, errorCode: code || null, modelIds: ids })}\n`);
  process.exit(result.status === 200 ? 0 : 1);
}

async function main() {
  const args = process.argv.slice(2);
  const asJson = args.includes('--json');
  const sub = String(args.find((a) => !a.startsWith('--')) || 'status').trim().toLowerCase();
  const key = readKey();
  if (sub === 'models') {
    await printModels(key);
    return;
  }
  if (sub === 'os-v4' || sub === 'business-os' || sub === 'captain') {
    const { executeAutonomousBusinessOsV4Run } = require('../scripts/autonomous-business-os-v4');
    const hostedMetrics = await fetchHostedBillingSummaryJson();
    const ledger = buildLedgerFromHosted(hostedMetrics);
    const record = executeAutonomousBusinessOsV4Run({
      funnel: ledger.funnelTelemetry,
    });
    if (asJson) {
      process.stdout.write(`${JSON.stringify(record, null, 2)}\n`);
      return;
    }
    process.stdout.write(
      [
        '================================================================================',
        `🏛️  AUTONOMOUS BUSINESS GROWTH & PROFIT OS v${record.schema_version} — CAPTAIN SCORECARD`,
        '================================================================================',
        `  • Run ID / Checkpoint    : ${record.run_id} / ${record.checkpoint_cursor}`,
        `  • Business Goal Contract : ${record.business_id} (v${record.business_goal_contract_version})`,
        `  • 7d / 30d / 90d Settled : $${record.financial_windows['7d'].netSettledRevenueUsd.toFixed(2)} / $${record.financial_windows['30d'].netSettledRevenueUsd.toFixed(2)} / $${record.financial_windows['90d'].netSettledRevenueUsd.toFixed(2)} (VERIFIED)`,
        `  • $0.00 Root-Cause Truth : ${record.reflection_monetize_diagnosis.headline}`,
        `  • #1 Ranked Opportunity  : ${record.opportunities[0].title} (score=${record.opportunities[0].priorityScore})`,
        '================================================================================',
      ].join('\n') + '\n'
    );
    return;
  }
  if (sub === 'fast-money' || sub === 'money' || sub === 'blitz' || sub === 'action' || sub === 'actions') {
    printFastMoney(asJson);
    return;
  }
  if (sub === 'channels' || sub === 'list-channels') {
    if (asJson) {
      process.stdout.write(`${JSON.stringify(MARKETING_CHANNELS, null, 2)}\n`);
      return;
    }
    process.stdout.write('Available marketing & revenue channels:\n');
    for (const [chId, ch] of Object.entries(MARKETING_CHANNELS)) {
      process.stdout.write(`  • ${chId.padEnd(10)}: ${ch.name} -> ${ch.targetUrl}\n`);
    }
    return;
  }
  if (sub === 'copy') {
    const rawTarget = args.filter((a) => !a.startsWith('--'))[1] || 'pitch';
    const channel = resolveChannel(rawTarget);
    if (!channel) {
      process.stderr.write(`reflection: unknown channel "${rawTarget}". Choose one of: hn, linkedin, x, recovery, pitch.\n`);
      process.exit(2);
    }
    const result = copyChannel(channel);
    if (asJson) {
      process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
      return;
    }
    process.stdout.write([
      '================================================================================',
      `📋 COPIED TO CLIPBOARD: ${channel.name}`,
      '================================================================================',
      `  • Channel ID    : ${channel.id}`,
      `  • Target URL    : ${channel.targetUrl}`,
      `  • Clipboard     : ${result.copiedToClipboard ? 'SUCCESS (Cmd+V to paste)' : 'FAILED (pbcopy unavailable)'}`,
      '',
      '--- TEXT PREVIEW ---',
      ...channel.copy.split('\n').map((l) => `  ${l}`),
      '--------------------',
      '',
      `  👉 To launch & open the browser tab immediately: ./bin/reflection launch ${channel.id}`,
      '================================================================================',
      '',
    ].join('\n'));
    return;
  }
  if (sub === 'launch' || sub === 'post') {
    const rawTarget = args.filter((a) => !a.startsWith('--'))[1];
    if (!rawTarget) {
      printFastMoney(asJson);
      return;
    }
    const channel = resolveChannel(rawTarget);
    if (!channel) {
      process.stderr.write(`reflection: unknown channel "${rawTarget}". Choose one of: hn, linkedin, x, recovery, pitch.\n`);
      process.exit(2);
    }
    const noOpen = args.includes('--no-open');
    const result = launchChannel(channel, { noOpen });
    if (asJson) {
      process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
      return;
    }
    process.stdout.write([
      '================================================================================',
      `🚀 LAUNCHING CHANNEL: ${channel.name}`,
      '================================================================================',
      `  • Channel ID    : ${channel.id}`,
      `  • Clipboard     : ${result.copiedToClipboard ? 'COPIED TO CLIPBOARD (Ready to Cmd+V)' : 'pbcopy unavailable'}`,
      `  • Browser Tab   : ${result.browserOpened ? 'OPENED IN BROWSER' : 'Skipped or headless'}`,
      `  • Target URL    : ${channel.targetUrl}`,
      '',
      '--- TEXT PREVIEW ---',
      ...channel.copy.split('\n').map((l) => `  ${l}`),
      '--------------------',
      '',
      '  ✅ Your post is in your clipboard! Switch to your browser tab and press Cmd+V to publish.',
      '================================================================================',
      '',
    ].join('\n'));
    return;
  }
  if (sub === 'status' || sub === '--status' || sub === 'help' || sub === '--help' || sub === 'monetize' || sub === 'sell' || sub === 'outreach' || sub === '--outreach') {
    await printSell(key, asJson);
    return;
  }
  if (sub === 'critique' || sub === 'roast' || sub === 'feedback') {
    const { harvestLiveViralCritiquesAndRoastHooks } = require('../scripts/fast-money-engine');
    const hostedMetrics = await fetchHostedBillingSummaryJson();
    const report = await harvestLiveViralCritiquesAndRoastHooks({ fetchLive: true, hostedMetrics });
    if (asJson) {
      process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
      return;
    }
    const sc = report.liveViralFeedbackScorecard;
    const topRoast = report.cunninghamRoastPack[0];
    if (topRoast && topRoast.postBody) {
      spawnSync('pbcopy', [], { input: `${topRoast.title}\n\n${topRoast.postBody}`, encoding: 'utf8', timeout: 3000 });
    }
    const outLines = [
      '================================================================================',
      '🔥 LIVE VIRAL CRITIQUE HARVESTER & CUNNINGHAM’S LAW ROAST ENGINE',
      '================================================================================',
      `  • All-Time Real User Pings / Installs : ${sc.allTimeRealUserPings} pings / ${sc.allTimeUniqueCliInstalls} cli_init pings (${sc.allTimeActiveCliInstalls} active installs · ${sc.allTimeCliCaptureEvents || 0} captures · ${sc.allTimeCliStatsEvents || 0} stats)`,
      `  • Checkout Clicks vs Abandonments     : ${sc.allTimeDirectStripeClicks} direct Stripe clicks · ${sc.allTimeCheckoutCancelViews} cancel views · ${sc.allTimeInterstitialAbandoned} interstitial abandonments (${sc.allTimeInterstitialViews || 0} views)`,
      `  • Explicit Written Critiques Logged   : ${sc.explicitWrittenCritiquesCount}${sc.topBuyerLossReason ? ` (top reason: ${sc.topBuyerLossReason.key}=${sc.topBuyerLossReason.count})` : ''}`,
      `  • Social CTA Clicks vs Bot Deflections: ${sc.socialHumanEventsCount} all-time social CTA clicks (${sc.socialCtaClicks30d || 0} in 30d) vs ${sc.socialBotDeflectionsCount} link-preview bot deflections`,
      '',
      '🔍 ROOT-CAUSE DIAGNOSIS & SHIPPED FIXES:',
      ...sc.rootCauseDiagnosis.map((d) => `  ${d}`),
      '',
      '💬 LIVE EXTERNAL DEVELOPER CRITIQUE THREADS (HN Algolia):',
      ...(report.liveExternalCritiqueThreads || []).map(
        (c) => `  • [${c.category}] @${c.author} on "${c.storyTitle.slice(0, 48)}": "${c.snippet.slice(0, 110)}..." -> ${c.itemUrl}`,
      ),
      '',
      '📣 CUNNINGHAM’S LAW "ROAST MY STACK" VIRAL PACK (HN #1 COPIED TO CLIPBOARD):',
      ...(report.cunninghamRoastPack || []).flatMap((p) => [
        `  --- [${p.channel.toUpperCase()}] ${p.title} ---`,
        `  Roast URL: ${p.roastUrl}`,
        ...p.postBody.split('\n').map((l) => `    ${l}`),
        '',
      ]),
      '================================================================================',
    ];
    process.stdout.write(`${outLines.join('\n')}\n`);
    return;
  }
  process.stderr.write(`reflection: "${sub}" is not a ThumbGate sale. Use reflection, reflection outreach, or reflection monetize.\n`);
  process.exit(2);
}

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`reflection: ${error.message}\n`);
    process.exit(1);
  });
}

module.exports = { assessHarnessOffer, PITCH };
