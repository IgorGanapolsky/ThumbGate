      pitch: PITCH,
      monetizeEngine: monetizeEngineReceipt
        ? {
            status: monetizeEngineReceipt.status,
            dispatchQueuePath: monetizeEngineReceipt.dispatchQueuePath,
            immediateDispatchCount: (monetizeEngineReceipt.immediateDispatchQueue || []).length,
            businessOsV4: monetizeEngineReceipt.businessOsV4 || null,
          }
        : null,
    };
    process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
    return;
  }
  const [hostedMetrics, checks, viralRadar] = await Promise.all([
    fetchHostedBillingSummaryJson(),
    Promise.all([
      probeStorefrontEndpoint('/health'),
      probeStorefrontEndpoint('/pricing'),
      probeStorefrontEndpoint('/checkout/pro'),
      probeStorefrontEndpoint('/diagnostic'),
    ]),
    (async () => {
      try {
        const { discoverLiveViralOpportunities } = require('../scripts/fast-money-engine');
        return await discoverLiveViralOpportunities({ limit: 4 });
      } catch {
        return null;
      }
    })(),
  ]);
  let critiqueReport = null;
  try {
    const { harvestLiveViralCritiquesAndRoastHooks } = require('../scripts/fast-money-engine');
    critiqueReport = await harvestLiveViralCritiquesAndRoastHooks({ fetchLive: true, hostedMetrics });
  } catch {
    critiqueReport = null;
  }
  const ledger = buildLedgerFromHosted(hostedMetrics);
  const copied = copyPitch();
  try {
    fs.mkdirSync(THUMBGATE_DIR, { recursive: true });
    fs.appendFileSync(MONETIZATION_RUNS_PATH, `${JSON.stringify({
      timestamp: new Date().toISOString(),
      action: 'reflection_monetize_active_execution',
      incurredReflectionCostUsd: 0.0,
      verifiedExternalRevenueTodayUsd: ledger.verifiedExternalCustomerRevenue.todayUsd,
