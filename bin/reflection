  const rev = ledger.verifiedExternalCustomerRevenue;
  const own = ledger.excludedOwnerAndTestCharges;
  const fn = ledger.funnelTelemetry;
  return [
    '================================================================================',
    '💰 HOW MUCH MONEY WE MADE — VERIFIED LIVE REVENUE LEDGER (HONESTY GATE)',
    '================================================================================',
    `  • TODAY (${ledger.todayUtc}) EXTERNAL REVENUE : $${rev.todayUsd.toFixed(2)}  (${rev.externalPaidOrdersCount} external paid orders)`,
    `  • LAST 7 DAYS EXTERNAL REVENUE        : $${rev.last7DaysUsd.toFixed(2)}`,
    `  • LAST 30 DAYS EXTERNAL REVENUE       : $${rev.last30DaysUsd.toFixed(2)}`,
    `  • ALL-TIME EXTERNAL CUSTOMER REVENUE  : $${rev.allTimeUsd.toFixed(2)}`,
    `  • EXCLUDED OWNER / TEST STRIPE ORDERS : $${own.totalUsd.toFixed(2)} net / $${own.grossUsd.toFixed(2)} gross ($${own.refundedUsd.toFixed(2)} refunded · ${own.count} self-test charges excluded)`,
    `  • LIVE FUNNEL TODAY (${ledger.todayUtc})      : ${fn.visitorsToday} visitors · ${fn.ctaClicksToday} CTA clicks · ${fn.checkoutStartsToday} checkouts · ${fn.cancelViewsToday} cancels`,
    `  • LIVE FUNNEL LAST 30 DAYS            : ${fn.visitors30d} visitors · ${fn.ctaClicks30d} CTA clicks · ${fn.checkoutStarts30d} checkouts · ${fn.cancelViews30d} cancels`,
    `  • REFLECTION AI CHARGES INCURRED      : $0.00   (Pays from Free Daily Allowance · Visa •••• 5302 locked at $0)`,
    '================================================================================',
  ].join('\n');
}

function getModels(key) {
  return new Promise((resolve) => {
    const req = https.request({
      host: 'api.reflection.ai',
      path: '/openai/v1/models',
      method: 'GET',
      headers: {
        Authorization: `Bearer ${key}`,
        Accept: 'application/json',
        'User-Agent': 'ThumbGate-reflection-cli/1.41.0',
      },
      timeout: 12000,
    }, (res) => {
      const chunks = [];
      res.on('data', (chunk) => chunks.push(chunk));
      res.on('end', () => {
        resolve({ status: res.statusCode || 0, body: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('timeout', () => {
      req.destroy();
      resolve({ status: 0, error: 'timeout' });
    });
    req.on('error', (error) => {
      resolve({ status: 0, error: error.code || 'error' });
    });
    req.end();
  });
}

function copyPitch() {
  const child = spawnSync('pbcopy', [], { input: PITCH, encoding: 'utf8', timeout: 3000 });
  return child.status === 0;
}

async function printSell(key, asJson = false) {
  const verdict = assessHarnessOffer(PITCH);
  if (!verdict.allow) {
    process.stderr.write(`reflection: pitch refused (${verdict.reason}). Nothing was copied or sent.\n`);
    process.exit(2);
  }
  let monetizeEngineReceipt = null;
  try {
    const { runReflectionMonetizeEngine } = require('../scripts/fast-money-engine');
    monetizeEngineReceipt = await runReflectionMonetizeEngine({
      runLiveSubprocesses: false,
      copyToClipboard: false,
      outboundCashSpendUsd: 0,
    });
  } catch {
    monetizeEngineReceipt = null;
  }
  if (asJson) {
    const payload = {
      status: 'ACTIVE',
      model: 'reflection-ai/Beam-1.0-501B-A23B',
      apiKeyPresent: key.present,
      apiKeySource: key.source,
      incurredReflectionCostUsd: 0.0,
      allowPaidOverage: false,
      cardChargeBlocked: true,
      checkoutLinks: CHECKOUT_LINKS,
      offers: OFFERS,
      pitch: PITCH,
      monetizeEngine: monetizeEngineReceipt
        ? {
            status: monetizeEngineReceipt.status,
            dispatchQueuePath: monetizeEngineReceipt.dispatchQueuePath,
            immediateDispatchCount: (monetizeEngineReceipt.immediateDispatchQueue || []).length,
          }
        : null,
    };
    process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
    return;
  }
  const [hostedMetrics, checks, viralRadar] = await Promise.all([
    fetchHostedBillingSummaryJson(),
    Promise.all([
      probeStorefrontEndpoint('/health'),
      probeStorefrontEndpoint('/pricing'),
      probeStorefrontEndpoint('/checkout/pro'),
      probeStorefrontEndpoint('/diagnostic'),
    ]),
    (async () => {
      try {
        const { discoverLiveViralOpportunities } = require('../scripts/fast-money-engine');
        return await discoverLiveViralOpportunities({ limit: 4 });
      } catch {
        return null;
      }
    })(),
  ]);
  let critiqueReport = null;
  try {
    const { harvestLiveViralCritiquesAndRoastHooks } = require('../scripts/fast-money-engine');
    critiqueReport = await harvestLiveViralCritiquesAndRoastHooks({ fetchLive: true, hostedMetrics });
  } catch {
    critiqueReport = null;
  }
  const ledger = buildLedgerFromHosted(hostedMetrics);
  const copied = copyPitch();
  try {
    fs.mkdirSync(THUMBGATE_DIR, { recursive: true });
    fs.appendFileSync(MONETIZATION_RUNS_PATH, `${JSON.stringify({
      timestamp: new Date().toISOString(),
      action: 'reflection_monetize_active_execution',
      incurredReflectionCostUsd: 0.0,
      verifiedExternalRevenueTodayUsd: ledger.verifiedExternalCustomerRevenue.todayUsd,
      funnelTelemetry: ledger.funnelTelemetry,
      clipboardPitchCopied: copied,
    })}\n`, 'utf8');
  } catch {
    // non-fatal
  }
  const fn = ledger.funnelTelemetry;
  const hnLines = viralRadar && Array.isArray(viralRadar.liveHnThreads)
    ? viralRadar.liveHnThreads.slice(0, 4).map(
        (t) => `     • [HN score=${t.velocityScore} | ${t.points}p/${t.comments}c] ${t.title.slice(0, 62)} -> ${t.itemUrl}`,
      )
    : [];
  const lines = [
    formatMoneyBox(ledger),
    '',
    '🚀 MONETIZATION READINESS & HONESTY GATE (LOCAL CLI DOES NOT AUTO-POST OR CHARGE):',
    `  0. Why $0.00 Was Made By Typing "reflection monetize":`,
    `     • This CLI is a local readiness + pitch-staging tool: it checks live storefront health and copies the pitch to pbcopy, but does NOT send outbound emails/posts by itself.`,
    `  1. Reflection Billing Guard : $0.00 charged (${ledger.reflectionBillingCost.plan})`,
    `     • Free Daily Allowance   : 10M uncached input/day + 1M output/day + Unlimited cached input`,
    `     • Local Hard Cap         : 8M input / 800K output per UTC day (allowPaidOverage=false — Visa •••• 5302 protected)`,
    `  2. Read-Only Storefront Health Probes (Zero Fake Stripe Sessions Minted):`,
    ...checks.map((c) => {
      const loc = c.location ? ` -> ${c.location.slice(0, 72)}...` : '';
      const err = c.error ? ` (${c.error})` : '';
      const note = c.note ? ` [${c.note}]` : '';
      return `     • [${c.status}${err}] ${c.url}${loc}${note}`;
    }),
    `  3. Funnel Conversion & Abandonment Diagnosis (${ledger.telemetrySource}):`,
    `     • Today (${ledger.todayUtc})     : ${fn.visitorsToday} visitors -> ${fn.ctaClicksToday} CTA clicks -> ${fn.checkoutStartsToday} Stripe checkouts -> ${fn.cancelViewsToday} cancels -> $0.00 paid`,
    `     • Last 30 Days           : ${fn.visitors30d} visitors -> ${fn.ctaClicks30d} CTA clicks -> ${fn.checkoutStarts30d} Stripe checkouts -> ${fn.cancelViews30d} cancels -> $0.00 paid`,
    `     • Downsell Recovery Armed: One-time $9.99 Playbook (/go/playbook-999) + $49 Rule-Pack (/go/bundle-49) live on /checkout/pro & /checkout/cancel`,
    `  4. Active Monetization Channels Armed ($0.00 Outbound Spend):`,
    ...OFFERS.map((offer) => `     • ${offer.name.padEnd(24)} ${offer.price.padEnd(12)} ${offer.url}`),
    `  5. Viral Multi-Channel Radar (Hacker News + LinkedIn + TikTok + Reddit + Lobste.rs):`,
    `     • Hacker News Show HN    : ${CHECKOUT_LINKS.hackerNewsShowHn}`,
    ...hnLines,
    `     • LinkedIn Carousel CTA  : ${CHECKOUT_LINKS.linkedinViralPro19}`,
    `     • TikTok Short-Video CTA : ${CHECKOUT_LINKS.tiktokViralPro19}`,
    `  6. UTM + Viral Attributed Pitch (${copied ? 'COPIED TO CLIPBOARD' : 'READY'}):`,
    ...PITCH.split('\n').map((line) => `     ${line}`),
    `  7. Active Monetize Engine Dispatch Queue (${monetizeEngineReceipt && monetizeEngineReceipt.makeMoneyReceiptOk ? 'READY' : 'UNAVAILABLE'}):`,
    ...(monetizeEngineReceipt && Array.isArray(monetizeEngineReceipt.immediateDispatchQueue)
      ? [
          `     • Queue Artifact Written : ${monetizeEngineReceipt.dispatchQueuePath}`,
          ...monetizeEngineReceipt.immediateDispatchQueue.slice(0, 4).map(
            (item) => `     • [#${item.priority} ${item.channel}] ${item.targetBuyer || item.target || 'Buyer'} (${item.targetOffer || item.offerPrice || '$49'}) -> ${item.checkoutUrl || item.actionUrl || item.intentUrl || 'staged'}`,
          ),
        ]
      : []),
    `  8. Live Viral Critique Harvester & Cunningham's Law Roast Loop (reflection critique):`,
    ...(critiqueReport && critiqueReport.liveViralFeedbackScorecard
      ? [
          `     • Live Feedback Scorecard: ${critiqueReport.liveViralFeedbackScorecard.explicitWrittenCritiquesCount} explicit critiques · ${critiqueReport.liveViralFeedbackScorecard.allTimeCheckoutCancelViews} cancel views · ${critiqueReport.liveViralFeedbackScorecard.allTimeInterstitialAbandoned} interstitial abandonments · ${critiqueReport.liveViralFeedbackScorecard.socialHumanEventsCount} real social views (${critiqueReport.liveViralFeedbackScorecard.socialBotDeflectionsCount} link-preview bots deflected)`,
          ...critiqueReport.liveViralFeedbackScorecard.rootCauseDiagnosis.map((d) => `     • ${d}`),
          `     • Roast Landing Funnel   : https://thumbgate.ai/?roast=1&utm_source=hackernews&utm_medium=roast_my_stack&utm_campaign=nov2026_roast`,
          `     • Public Roast Endpoint  : POST https://thumbgate.ai/v1/feedback/roast  |  CLI: npx thumbgate roast "your critique"`,
        ]
      : []),
    formatMoneyBox(ledger),
  ];
  process.stdout.write(`${lines.join('\n')}\n`);
}

async function printModels(key) {
  if (!key.present || !key.value) {
    process.stderr.write('reflection models: no API key. No request was sent.\n');
    process.exit(2);
  }
  const result = await getModels(key.value);
  if (result.error) {
    process.stderr.write(`reflection models: ${result.error}\n`);
    process.exit(1);
  }
  let ids = [];
  let code = '';
  try {
    const parsed = JSON.parse(result.body || '{}');
    ids = Array.isArray(parsed.data) ? parsed.data.map((row) => row.id).filter(Boolean) : [];
    code = parsed.error && parsed.error.code ? String(parsed.error.code) : '';
  } catch {
    code = 'unreadable_response';
  }
  process.stdout.write(`${JSON.stringify({ status: result.status, errorCode: code || null, modelIds: ids })}\n`);
  process.exit(result.status === 200 ? 0 : 1);
}

async function main() {
  const args = process.argv.slice(2);
  const asJson = args.includes('--json');
  const sub = String(args.find((a) => !a.startsWith('--')) || 'status').trim().toLowerCase();
  const key = readKey();
  if (sub === 'models') {
    await printModels(key);
    return;
  }
  if (sub === 'status' || sub === '--status' || sub === 'help' || sub === '--help' || sub === 'monetize' || sub === 'sell' || sub === 'outreach' || sub === '--outreach') {
    await printSell(key, asJson);
    return;
  }
  if (sub === 'critique' || sub === 'roast' || sub === 'feedback') {
    const { harvestLiveViralCritiquesAndRoastHooks } = require('../scripts/fast-money-engine');
    const report = await harvestLiveViralCritiquesAndRoastHooks({ fetchLive: true });
    if (asJson) {
      process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
      return;
    }
    const sc = report.liveViralFeedbackScorecard;
    const topRoast = report.cunninghamRoastPack[0];
    if (topRoast && topRoast.postBody) {
      spawnSync('pbcopy', [], { input: `${topRoast.title}\n\n${topRoast.postBody}`, encoding: 'utf8', timeout: 3000 });
    }
    const outLines = [
      '================================================================================',
      '🔥 LIVE VIRAL CRITIQUE HARVESTER & CUNNINGHAM’S LAW ROAST ENGINE',
      '================================================================================',
      `  • All-Time Real User Pings / Installs : ${sc.allTimeRealUserPings} pings / ${sc.allTimeUniqueCliInstalls} installs (${sc.allTimeActiveCliInstalls} active)`,
      `  • Checkout Clicks vs Abandonments     : ${sc.allTimeDirectStripeClicks} direct Stripe clicks · ${sc.allTimeCheckoutCancelViews} cancel views · ${sc.allTimeInterstitialAbandoned} interstitial abandonments`,
      `  • Explicit Written Critiques Logged   : ${sc.explicitWrittenCritiquesCount}`,
      `  • Social Traffic (Human vs Link Bots) : ${sc.socialHumanEventsCount} human events vs ${sc.socialBotDeflectionsCount} link-preview bot deflections`,
      '',
      '🔍 ROOT-CAUSE DIAGNOSIS & SHIPPED FIXES:',
      ...sc.rootCauseDiagnosis.map((d) => `  ${d}`),
      '',
      '💬 LIVE EXTERNAL DEVELOPER CRITIQUE THREADS (HN Algolia):',
      ...(report.liveExternalCritiqueThreads || []).map(
        (c) => `  • [${c.category}] @${c.author} on "${c.storyTitle.slice(0, 48)}": "${c.snippet.slice(0, 110)}..." -> ${c.itemUrl}`,
      ),
      '',
      '📣 CUNNINGHAM’S LAW "ROAST MY STACK" VIRAL PACK (HN #1 COPIED TO CLIPBOARD):',
      ...(report.cunninghamRoastPack || []).flatMap((p) => [
        `  --- [${p.channel.toUpperCase()}] ${p.title} ---`,
        `  Roast URL: ${p.roastUrl}`,
        ...p.postBody.split('\n').map((l) => `    ${l}`),
        '',
      ]),
      '================================================================================',
    ];
    process.stdout.write(`${outLines.join('\n')}\n`);
    return;
  }
  process.stderr.write(`reflection: "${sub}" is not a ThumbGate sale. Use reflection, reflection outreach, or reflection monetize.\n`);
  process.exit(2);
}

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`reflection: ${error.message}\n`);
    process.exit(1);
  });
}

module.exports = { assessHarnessOffer, PITCH };
