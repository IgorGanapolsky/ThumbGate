# Core runtime
# Required for API auth (unless THUMBGATE_ALLOW_INSECURE=true in local isolated testing)
THUMBGATE_API_KEY=change-me
# THUMBGATE_OPERATOR_KEY=tg_op_...  # Read-only billing key for CLI→prod (run: node bin/cli.js billing:setup)
# THUMBGATE_HUMAN_REVIEWER_KEY=generate-an-independent-high-entropy-key
# THUMBGATE_HUMAN_REVIEWER_ID=stable-reviewer-identity
# THUMBGATE_API_KEY_ROTATED_AT=2026-03-12T00:00:00.000Z
# THUMBGATE_PUBLIC_APP_ORIGIN=https://thumbgate.ai
# THUMBGATE_BILLING_API_BASE_URL=https://thumbgate.ai
# THUMBGATE_FEEDBACK_DIR=/data/feedback
# Optional canonical revenue-pipeline override. Linked Git worktrees otherwise
# share the primary checkout's .thumbgate/sales-pipeline.jsonl automatically.
# THUMBGATE_SALES_PIPELINE_PATH=/absolute/path/to/sales-pipeline.jsonl
# THUMBGATE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# THUMBGATE_OWNER_EMAILS=you@example.com,alt@example.com  # comma-separated; owner traffic classified separately in analytics
# THUMBGATE_GOOGLE_SITE_VERIFICATION=google-site-verification-token
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:thumbgate.ai

